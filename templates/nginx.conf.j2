server {
    listen 8082;
    server_name localhost;

    root /var/www/html;

    index index.html;

    location / {
        
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    error_page 403 /index.html;
    error_page 404 /index.html;

    location ~* (\.html|\/sw\.js)$ {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
    }
}
